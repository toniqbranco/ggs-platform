# Optional: the website builds and runs without an environment file.
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WP-01 must stay disconnected. true is intentionally rejected.
NEXT_PUBLIC_SUPABASE_ENABLED=false
# Leave both fields empty. Do not insert real credentials for WP-01.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Privileged, secret, service-role, and legacy anon keys are unsupported.
