    "check": "pnpm lint && pnpm typecheck && pnpm format:check"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.25.0"
  }
}
