{
  "name": "ggs-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm validate:env && pnpm lint && pnpm typecheck && pnpm format:check",
    "validate:env": "tsx scripts/validate-env.ts",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:storage",
    "test:storage": "node --conditions=react-server --import tsx --test tests/storage/*.test.ts",
    "test:storage:pg17": "node --conditions=react-server --import tsx --test tests/postgres17/*.test.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "security:audit": "pnpm audit --audit-level=high",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "client-only": "0.0.1",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.11",
    "@next/env": "16.4.3",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.25.0"
  }
}
